# Public URL of the deployed FastAPI backend service for https://pms-eta-rust.vercel.app
VITE_API_BASE_URL=https://your-backend-service.up.railway.app

# Optional Socket.IO endpoint for real-time updates.
VITE_SOCKET_URL=
VITE_REALTIME_ENABLED=false

# Enable only when the backend scoped performance API is enabled. This keeps
# dashboard reads bounded instead of loading the legacy full performance dump.
VITE_SCOPED_PERFORMANCE_API=false

# Optional endpoint for web-vitals telemetry. Leave empty unless configured.
VITE_VITALS_ENDPOINT=

