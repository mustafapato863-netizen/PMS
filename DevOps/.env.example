# ==============================================================================
# PMS Dashboard - DevOps Environment Configuration Template
# ==============================================================================

# Backend Configuration
APP_ENV=production
DATABASE_URL=postgresql://postgres:<password>@db:5432/PMS_Sys
PMS_AUTO_SEED=false
PMS_SEED_PERMISSIONS_ON_STARTUP=false
PMS_SEED_DEMO_LEVELS=false
ENABLE_FILE_LOGGING=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_RECYCLE=1800
REDIS_URL=redis://:<password>@redis:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=0.25
REDIS_RETRY_INTERVAL_SECONDS=30
PMS_REALTIME_MODE=disabled
PMS_REPORT_CENTER_ENABLED=true
JWT_SECRET=<replace-with-a-32-byte-random-secret>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ALLOWED_ORIGINS=https://pms-eta-rust.vercel.app,https://pms-egzjdxcfx-zain-mustafas-projects.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_ARCHIVE_BYTES=209715200
MAX_UPLOAD_SHEETS=100
MAX_UPLOAD_ROWS_PER_SHEET=250000
MAX_UPLOAD_COLUMNS_PER_SHEET=512
FRONTEND_URL=https://pms-eta-rust.vercel.app

# Frontend Configuration
VITE_API_BASE_URL=https://pms-backend-six.vercel.app
VITE_SOCKET_URL=http://localhost:8000
VITE_REALTIME_ENABLED=false
VITE_REPORT_CENTER_ENABLED=true

# PostgreSQL Container Configuration
POSTGRES_DB=PMS_Sys
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<replace-with-a-strong-password>
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Container Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<replace-with-a-strong-url-safe-password>

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<replace-with-a-strong-password>

# Deployment Metadata
ENVIRONMENT=production
APP_VERSION=2.0.0

# AI Configuration (Cloudflare Workers AI Primary, Google Gemini Fallback)
PMS_AI_PRIMARY_PROVIDER=cloudflare
PMS_AI_FALLBACK_PROVIDER=gemini
PMS_AI_CLOUDFLARE_ENABLED=true
PMS_AI_GEMINI_ENABLED=true
PMS_AI_FALLBACK_ENABLED=true

# Primary: Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=<your-cloudflare-account-id>
CLOUDFLARE_API_TOKEN=<your-cloudflare-api-token>
CLOUDFLARE_AI_MODEL=@cf/ibm-granite/granite-4.0-h-micro
# Alternative: CLOUDFLARE_AI_MODEL=@cf/zai-org/glm-4.7-flash

# Fallback: Google Gemini
GEMINI_API_KEY=<your-google-gemini-api-key>
PMS_GEMINI_MODEL=gemini-2.5-flash

# OpenAI is retired/disabled (no API key required)
# OPENAI_API_KEY=

PMS_AI_TIMEOUT_SECONDS=10.0
PMS_AI_MAX_RETRIES=1
PMS_RATE_LIMIT_AI_CHAT_PER_MINUTE=20
