# ==============================================================================
# PMS Dashboard - DevOps Environment Configuration Template
# ==============================================================================

# Backend Configuration
APP_ENV=production
DATABASE_URL=postgresql://postgres:<password>@db:5432/PMS_Sys
PMS_AUTO_SEED=false
PMS_SEED_PERMISSIONS_ON_STARTUP=false
PMS_SEED_DEMO_LEVELS=false
ENABLE_FILE_LOGGING=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_RECYCLE=1800
REDIS_URL=redis://:<password>@redis:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=0.25
REDIS_RETRY_INTERVAL_SECONDS=30
PMS_REALTIME_MODE=disabled
PMS_REPORT_CENTER_ENABLED=true
JWT_SECRET=<replace-with-a-32-byte-random-secret>
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ALLOWED_ORIGINS=https://pms-eta-rust.vercel.app,https://pms-egzjdxcfx-zain-mustafas-projects.vercel.app,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,http://localhost:3000
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_ARCHIVE_BYTES=209715200
MAX_UPLOAD_SHEETS=100
MAX_UPLOAD_ROWS_PER_SHEET=250000
MAX_UPLOAD_COLUMNS_PER_SHEET=512
FRONTEND_URL=https://pms-eta-rust.vercel.app

# Frontend Configuration
VITE_API_BASE_URL=https://pms-backend-six.vercel.app
VITE_SOCKET_URL=http://localhost:8000
VITE_REALTIME_ENABLED=false
VITE_REPORT_CENTER_ENABLED=true

# PostgreSQL Container Configuration
POSTGRES_DB=PMS_Sys
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<replace-with-a-strong-password>
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis Container Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=<replace-with-a-strong-url-safe-password>

# Monitoring Configuration
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=<replace-with-a-strong-password>

# Deployment Metadata
ENVIRONMENT=production
APP_VERSION=2.0.0

# Self-hosted PMS model. See docs/ops/self-hosted-llm.md.
# Set these in Dokploy's environment UI as well as in this file. Do not publish the model port.
PMS_AI_LLM_BASE_URL=http://pms-qwen-pilot:8080
PMS_AI_LLM_MODEL=qwen3-4b-q4_k_m
PMS_AI_LLM_API_KEY=
PMS_AI_LLM_ALLOWED_HOSTS=localhost,127.0.0.1,::1,llm,pms-qwen-pilot,host.docker.internal
PMS_AI_LLM_INTENT_ENABLED=false
PMS_AI_LLM_SYNTHESIS_ENABLED=false
PMS_AI_LLM_EXPLORATION_ENABLED=false
PMS_AI_LLM_TIMEOUT_SECONDS=15
PMS_AI_LLM_SYNTHESIS_TIMEOUT_SECONDS=30
PMS_AI_LLM_MAX_CALLS_PER_TURN=3
PMS_AI_LLM_CONTEXT=2048
PMS_AI_LLM_MODEL_PATH=/models/Qwen3-4B-Q4_K_M.gguf
PMS_AI_LLM_MODEL_DIR=/opt/pms-qwen-pilot/models
PMS_AI_LLM_THREADS=1
PMS_AI_LLM_MEMORY_LIMIT=3584m
PMS_AI_LLM_CPUS=1
PMS_RATE_LIMIT_AI_CHAT_PER_MINUTE=20
