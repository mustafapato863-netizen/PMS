# Public hostname already pointing to the Hostinger VPS IP.
APP_DOMAIN=pms.example.com
ACME_EMAIL=admin@example.com

# Release image tag. GitHub Actions replaces this with the commit SHA.
APP_VERSION=local

# Supabase PostgreSQL connection. Keep sslmode=require.
DATABASE_URL=postgresql://user:password@pooler.example.supabase.com:6543/postgres?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_RECYCLE=1800

# Generate separate, high-entropy URL-safe values for these secrets.
JWT_SECRET=replace-with-at-least-32-random-bytes
REDIS_PASSWORD=replace-with-a-strong-url-safe-password

# Same-origin browser deployment. Keep these empty so the frontend uses APP_DOMAIN.
VITE_API_BASE_URL=
VITE_SOCKET_URL=
VITE_REALTIME_ENABLED=true

CORS_ALLOWED_ORIGINS=https://pms.example.com
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
PMS_REALTIME_MODE=in_process
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_ARCHIVE_BYTES=209715200
MAX_UPLOAD_SHEETS=100
MAX_UPLOAD_ROWS_PER_SHEET=250000
MAX_UPLOAD_COLUMNS_PER_SHEET=512
LOG_LEVEL=INFO

# Self-hosted Qwen3-4B. See docs/ops/self-hosted-llm.md.
# Leave the API key empty. The live container does not require one.
PMS_AI_LLM_BASE_URL=http://pms-qwen-pilot:8080
PMS_AI_LLM_MODEL=qwen3-4b-q4_k_m
PMS_AI_LLM_API_KEY=
PMS_AI_LLM_ALLOWED_HOSTS=localhost,127.0.0.1,::1,llm,pms-qwen-pilot,host.docker.internal
PMS_AI_LLM_INTENT_ENABLED=false
PMS_AI_LLM_SYNTHESIS_ENABLED=false
PMS_AI_LLM_EXPLORATION_ENABLED=false
PMS_AI_LLM_TIMEOUT_SECONDS=15
PMS_AI_LLM_SYNTHESIS_TIMEOUT_SECONDS=30
PMS_AI_LLM_MAX_CALLS_PER_TURN=3
PMS_AI_LLM_CONTEXT=2048
PMS_AI_LLM_MODEL_PATH=/models/Qwen3-4B-Q4_K_M.gguf
PMS_AI_LLM_MODEL_DIR=/opt/pms-qwen-pilot/models
PMS_AI_LLM_THREADS=1
PMS_AI_LLM_MEMORY_LIMIT=3584m
PMS_AI_LLM_CPUS=1
PMS_RATE_LIMIT_AI_CHAT_PER_MINUTE=20
