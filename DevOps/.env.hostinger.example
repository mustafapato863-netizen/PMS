# Public hostname already pointing to the Hostinger VPS IP.
APP_DOMAIN=pms.example.com
ACME_EMAIL=admin@example.com

# Release image tag. GitHub Actions replaces this with the commit SHA.
APP_VERSION=local

# Supabase PostgreSQL connection. Keep sslmode=require.
DATABASE_URL=postgresql://user:password@pooler.example.supabase.com:6543/postgres?sslmode=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_RECYCLE=1800

# Generate separate, high-entropy URL-safe values for these secrets.
JWT_SECRET=replace-with-at-least-32-random-bytes
REDIS_PASSWORD=replace-with-a-strong-url-safe-password

# Same-origin browser deployment. Keep these empty so the frontend uses APP_DOMAIN.
VITE_API_BASE_URL=
VITE_SOCKET_URL=
VITE_REALTIME_ENABLED=true

CORS_ALLOWED_ORIGINS=https://pms.example.com
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
PMS_REALTIME_MODE=in_process
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_ARCHIVE_BYTES=209715200
MAX_UPLOAD_SHEETS=100
MAX_UPLOAD_ROWS_PER_SHEET=250000
MAX_UPLOAD_COLUMNS_PER_SHEET=512
LOG_LEVEL=INFO

# Optional dedicated key material for Admin-managed AI provider secrets (falls back to JWT_SECRET when empty).
PMS_SECRETS_ENCRYPTION_KEY=

# AI configuration: NVIDIA NIM (primary), Cloudflare Workers AI (fallback). OpenAI is decommissioned.
PMS_AI_PRIMARY_PROVIDER=nvidia
PMS_AI_FALLBACK_PROVIDER=cloudflare
PMS_AI_CLOUDFLARE_ENABLED=true
PMS_AI_NVIDIA_ENABLED=true
PMS_AI_NVIDIA_REASONING_EFFORT=auto
PMS_AI_FALLBACK_ENABLED=true
PMS_AI_OPENAI_ENABLED=false
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_MODEL=@cf/ibm-granite/granite-4.0-h-micro
CLOUDFLARE_AI_MODEL_ALTER=@cf/zai-org/glm-4.7-flash
PMS_RATE_LIMIT_AI_CHAT_PER_MINUTE=20
PMS_AI_MAX_CONCURRENT_CHAT_REQUESTS=8
PMS_AI_DAILY_USER_REQUEST_LIMIT=0
PMS_AI_DAILY_USER_TOKEN_LIMIT=0
PMS_AI_MODEL_LED_PILOT_ENABLED=false
# Admin-only AI Feedback Analyzer (Direct NVIDIA NIM — disabled by default)
PMS_AI_FEEDBACK_ANALYZER_ENABLED=false
NVIDIA_API_KEY=
# Required for NVIDIA chat.
NVIDIA_API_KEY_ALTER=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_FEEDBACK_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
PMS_AI_FEEDBACK_ANALYZER_TIMEOUT_SECONDS=20
PMS_AI_FEEDBACK_ANALYZER_DAILY_LIMIT=50
