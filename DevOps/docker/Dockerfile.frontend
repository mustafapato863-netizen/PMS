# syntax=docker/dockerfile:1.7
FROM node:24-alpine AS builder

WORKDIR /workspace/Frontend

COPY Frontend/package*.json ./
RUN npm ci

COPY Frontend/ ./

ARG VITE_API_BASE_URL=
ARG VITE_SOCKET_URL=
ARG VITE_REALTIME_ENABLED=true
ARG VITE_SCOPED_PERFORMANCE_API=false
ARG VITE_REPORT_CENTER_ENABLED=true
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL} \
    VITE_SOCKET_URL=${VITE_SOCKET_URL} \
    VITE_REALTIME_ENABLED=${VITE_REALTIME_ENABLED} \
    VITE_SCOPED_PERFORMANCE_API=${VITE_SCOPED_PERFORMANCE_API} \
    VITE_REPORT_CENTER_ENABLED=${VITE_REPORT_CENTER_ENABLED}

RUN npm run build:ci

FROM nginx:alpine

COPY --from=builder /workspace/Frontend/dist /usr/share/nginx/html
COPY DevOps/nginx/frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q -O /dev/null http://127.0.0.1/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
